@model RebanhoVm
@{ ViewData["Title"] = Model.Nome; ViewData["Rebanho"] = Model.Id; }
@if (TempData["Mensagem"] is string mensagem) { <div class="alert alert-success" role="status">@mensagem</div> }
<div class="mb-4"><p class="eyebrow text-break">@Model.Propriedade</p><h1 class="text-break">@Model.Nome</h1><p class="text-muted">Último cálculo: @Model.AtualizadoEmUtc.ToString("dd/MM/yyyy HH:mm") UTC</p>
<div class="d-flex flex-wrap gap-2"><a asp-action="Index" class="btn btn-outline-secondary">Meus rebanhos</a><a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-success">Editar rebanho</a><a asp-action="Excluir" asp-route-id="@Model.Id" class="btn btn-outline-danger">Excluir</a></div></div>
<partial name="~/Views/Simulacao/Relatorio.cshtml" model="Model.Resultado" />

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — Score do Rebanho</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="visually-hidden-focusable" href="#conteudo">Ir para o conteúdo</a>
    <header class="site-header mb-4 mb-lg-5">
        <nav class="container py-3 d-flex flex-wrap gap-3 align-items-center" aria-label="Navegação principal">
            <a class="navbar-brand d-flex align-items-center gap-2 me-auto" asp-controller="Simulacao" asp-action="Index">
                <span class="brand-mark" aria-hidden="true">SR</span>
                <span>Score <strong>do Rebanho</strong></span>
            </a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="nav-link" asp-controller="Simulacao" asp-action="Index">Nova simulação</a>
                <a class="nav-link" asp-controller="Conta" asp-action="Senha">Minha conta</a>
                <form asp-controller="Conta" asp-action="Sair" method="post">
                    <button class="btn btn-outline-secondary btn-sm">Sair</button>
                </form>
            }
            else
            {
                <a class="nav-link" asp-controller="Conta" asp-action="Entrar">Entrar</a>
                <a class="btn btn-outline-success btn-sm" asp-controller="Conta" asp-action="Cadastrar">Criar conta</a>
            }
        </nav>
    </header>
    <main id="conteudo" class="container pb-5">@RenderBody()</main>
    <footer class="container border-top py-4 d-flex flex-wrap justify-content-between gap-2 small text-muted">
        <span class="fw-semibold">Score do Rebanho</span>
        <span>Mais clareza para planejar. Premissas para conferir.</span>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

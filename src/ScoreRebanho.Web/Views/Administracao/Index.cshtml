@model HistoricoVm
@{ ViewData["Title"] = "Administração"; }
<p class="eyebrow">Administração · Consulta</p>
<h1>Scores do rebanho</h1>
<p class="text-muted">Histórico dos scores gerados pelos usuários. Os relatórios preservam as premissas usadas no momento do cálculo.</p>
<div class="card table-responsive my-4"><table class="table mb-0">
<thead><tr><th>Data (UTC)</th><th>Autor</th><th>Score</th><th>Classificação</th><th>Relatório</th></tr></thead>
<tbody>
@foreach (var score in Model.Scores)
{
<tr><td>@score.CriadoEmUtc.ToString("dd/MM/yyyy HH:mm")</td><td>@score.Autor</td><td>@score.Score / 100</td><td>@score.Classificacao</td><td><a asp-action="Detalhes" asp-route-id="@score.Id" class="link-success">Ver relatório</a></td></tr>
}
</tbody></table></div>
@if (Model.Scores.Count == 0) { <p class="alert alert-info">Nenhum score nesta página. O histórico começa com os novos cálculos.</p> }
<nav aria-label="Páginas do histórico" class="d-flex gap-3 align-items-center">
@if (Model.Pagina > 1) { <a asp-route-pagina="@(Model.Pagina - 1)" class="btn btn-outline-success">Anterior</a> }
<span>Página @Model.Pagina</span>
@if (Model.Scores.Count == 20) { <a asp-route-pagina="@(Model.Pagina + 1)" class="btn btn-outline-success">Próxima</a> }
</nav>
